{
  "info": {
    "_postman_id": "8f54fd70-9790-4a68-9aec-mentor-market",
    "name": "Mentor Market API",
    "description": "End-to-end sample requests for the Mentor Market university project. Run the login requests first to populate role tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "studentToken", "value": "" },
    { "key": "tutorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "requestId", "value": "1" },
    { "key": "applicationId", "value": "1" },
    { "key": "bookingId", "value": "1" },
    { "key": "paymentId", "value": "1" },
    { "key": "assignmentId", "value": "1" },
    { "key": "quizId", "value": "1" },
    { "key": "courseId", "value": "1" },
    { "key": "verificationId", "value": "2" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"New Student\",\n  \"email\": \"new.student@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"student\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login Student",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('studentToken', json.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ayesha@mentormarket.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Tutor",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('tutorToken', json.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"farhan@mentormarket.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('adminToken', json.data.token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@mentormarket.test\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Profiles and Listings",
      "item": [
        {
          "name": "Create or Update Student Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"class_level\": \"Class 10\",\n  \"institution\": \"Example School\",\n  \"location\": \"Dhaka\",\n  \"subjects\": [\"Mathematics\", \"Physics\"],\n  \"learning_goals\": \"Prepare for SSC\"\n}" },
            "url": "{{baseUrl}}/students/profile"
          }
        },
        {
          "name": "Create or Update Tutor Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"qualifications\": \"BSc in Mathematics\",\n  \"experience_years\": 6,\n  \"subjects\": [\"Mathematics\", \"Physics\"],\n  \"teaching_mode\": \"both\",\n  \"hourly_rate\": 800,\n  \"location\": \"Dhaka\",\n  \"availability\": \"Weekday evenings\",\n  \"bio\": \"Concept-focused tutor\"\n}" },
            "url": "{{baseUrl}}/tutors/profile"
          }
        },
        {
          "name": "Create Tutor Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Friendly Algebra Coaching\",\n  \"subject\": \"Mathematics\",\n  \"level\": \"Class 8-10\",\n  \"price\": 750,\n  \"teaching_mode\": \"online\",\n  \"availability\": \"Sunday and Tuesday evenings\",\n  \"has_trial\": true,\n  \"thumbnail_url\": \"/media/math-studio.svg\",\n  \"demo_video_url\": \"/media/math-demo.mp4\",\n  \"description\": \"Step-by-step algebra coaching with practice tests.\"\n}" },
            "url": "{{baseUrl}}/tutor-posts"
          }
        },
        {
          "name": "Create Student Request",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('requestId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"subject\": \"Physics\",\n  \"class_level\": \"Class 10\",\n  \"budget\": 750,\n  \"location\": \"Dhaka\",\n  \"teaching_mode\": \"online\",\n  \"preferred_time\": \"Tuesday at 7 PM\",\n  \"required_experience\": \"3 years\",\n  \"description\": \"Need help with mechanics.\"\n}" },
            "url": "{{baseUrl}}/student-requests"
          }
        }
      ]
    },
    {
      "name": "Marketplace Workflow",
      "item": [
        {
          "name": "Apply to Request",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('applicationId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"student_request_id\": {{requestId}},\n  \"proposal_message\": \"I can help with visual explanations and exam practice.\",\n  \"expected_fee\": 750,\n  \"available_time\": \"Tuesday at 7 PM\"\n}" },
            "url": "{{baseUrl}}/applications"
          }
        },
        {
          "name": "Create Booking",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('bookingId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"tutor_id\": 5,\n  \"tutor_post_id\": 1,\n  \"class_type\": \"trial\",\n  \"class_date\": \"2026-08-01\",\n  \"class_time\": \"18:00:00\",\n  \"duration_minutes\": 60,\n  \"mode\": \"online\"\n}" },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"receiver_id\": 5,\n  \"booking_id\": {{bookingId}},\n  \"content\": \"Hello! What should I prepare before class?\"\n}" },
            "url": "{{baseUrl}}/messages"
          }
        },
        {
          "name": "Add Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"booking_id\": 4,\n  \"rating\": 5,\n  \"comment\": \"Clear explanations and useful examples.\"\n}" },
            "url": "{{baseUrl}}/reviews"
          }
        },
        {
          "name": "Make Mock Payment",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('paymentId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"booking_id\": {{bookingId}},\n  \"amount\": 800,\n  \"payment_method\": \"bKash\"\n}" },
            "url": "{{baseUrl}}/payments"
          }
        }
      ]
    },
    {
      "name": "Course Discovery and Engagement",
      "item": [
        {
          "name": "View Course Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/tutor-posts/{{courseId}}"
          }
        },
        {
          "name": "Save Course",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/course-engagement/saved/{{courseId}}"
          }
        },
        {
          "name": "List Saved Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/course-engagement/saved"
          }
        },
        {
          "name": "Record Course View",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"course_id\": {{courseId}}\n}" },
            "url": "{{baseUrl}}/course-engagement/views"
          }
        },
        {
          "name": "Recently Viewed Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/course-engagement/recent?limit=6"
          }
        },
        {
          "name": "Remove Saved Course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/course-engagement/saved/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Learning Tools",
      "item": [
        {
          "name": "Create Assignment",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('assignmentId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Mechanics Practice\",\n  \"description\": \"Solve the five attached problems.\",\n  \"deadline\": \"2026-08-05 23:59:00\",\n  \"student_id\": 2\n}" },
            "url": "{{baseUrl}}/assignments"
          }
        },
        {
          "name": "Submit Assignment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"submission_text\": \"My complete written solution is attached.\",\n  \"submission_file_url\": \"https://files.example.com/submission.pdf\"\n}" },
            "url": "{{baseUrl}}/assignments/{{assignmentId}}/submit"
          }
        },
        {
          "name": "Create Quiz",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.id) pm.collectionVariables.set('quizId', json.data.id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tutorToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Physics Check\",\n  \"subject\": \"Physics\",\n  \"questions\": [\n    {\"prompt\": \"What is the SI unit of force?\", \"options\": [\"Joule\", \"Newton\", \"Watt\"], \"correctAnswer\": 1, \"points\": 10}\n  ]\n}" },
            "url": "{{baseUrl}}/quizzes"
          }
        },
        {
          "name": "View Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/notifications"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "View Dashboard Analytics",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/dashboard" }
        },
        {
          "name": "Admin Verify Tutor",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"verified\",\n  \"admin_feedback\": \"Credentials and demo lesson approved.\"\n}" },
            "url": "{{baseUrl}}/verifications/{{verificationId}}/decision"
          }
        }
      ]
    }
  ]
}
